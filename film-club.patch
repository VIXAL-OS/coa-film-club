diff --git a/WoW/Source/Ui/Film/FilmSurface.cpp b/WoW/Source/Ui/Film/FilmSurface.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e5710f1e39561da4bedf97ed59135c4ef14c1888
--- /dev/null
+++ b/WoW/Source/Ui/Film/FilmSurface.cpp
@@ -0,0 +1,60 @@
+#include "FilmSurface.h"
+#include "Engine/Source/Gx/Gx.h"
+#include "Engine/Source/Gx/CGxDeviceD3d/CGxDeviceD3d.h"
+#include "Engine/Source/Gx/CGxDeviceD3d9Ex/CGxDeviceD3d9Ex.h"
+#include <cstring>
+
+namespace CoAFilm {
+void Surface::reset() {
+    pipeline_.reset();
+    if (texture_) GxTexDestroy(texture_);
+    texture_ = nullptr; pixels_ = nullptr;
+}
+IDirect3DDevice9* Surface::device() {
+    if (!g_theGxDevicePtr || !g_theGxDevicePtr->m_context) return nullptr;
+    switch (g_theGxDevicePtr->DeviceApi()) {
+    case GxApi_D3d9: return static_cast<CGxDeviceD3d*>(g_theGxDevicePtr)->m_d3dDevice;
+    case GxApi_D3d9Ex: return static_cast<CGxDeviceD3d9Ex*>(g_theGxDevicePtr)->m_d3dDevice;
+    default: return nullptr;
+    }
+}
+const char* Surface::draw(const std::vector<unsigned char>& pixels, unsigned w, unsigned h,
+                          bool changed, C3Vector p, C3Vector right, float aspect) {
+    auto* d = device();
+    if (!d || !w || !h || pixels.size() != size_t(w)*h*4) return "Waiting for a video frame.";
+    if (texture_ && (w != width_ || h != height_)) reset();
+    width_ = w; height_ = h; pixels_ = &pixels;
+    auto latch = [](EGxTexCommand cmd, uint32_t w, uint32_t h, uint32_t, uint32_t level, void* user,
+                    uint32_t& stride, const void*& data) {
+        const Surface& s = *static_cast<const Surface*>(user);
+        if (cmd==GxTex_Latch && !level && w==s.width_ && h==s.height_ && s.pixels_ &&
+            s.pixels_->size()==size_t(w)*h*4) { stride=w*4; data=s.pixels_->data(); }
+    };
+    if (!texture_ && !GxTexCreate(GxTex_NonPow2,w,h,1,GxTex_Argb8888,GxTex_Argb8888,
+            CGxTexFlags(GxTex_Linear),this,latch,"CoA Film Club",texture_))
+        return "The device could not create the film texture.";
+    if (changed || texture_->m_needsCreation || texture_->m_needsUpdate)
+        GxTexUpdate(texture_,0,0,w,h,1);
+    // D3D9Ex keeps a CPU copy until a texture first enters its hardware cache.
+    if (g_theGxDevicePtr->DeviceApi() == GxApi_D3d9Ex && texture_->m_apiSpecificData2) {
+        auto* ex = static_cast<CGxDeviceD3d9Ex*>(g_theGxDevicePtr);
+        if (!texture_->m_apiSpecificData) {
+            ex->ITexAcquire(texture_);
+            if (texture_->m_apiSpecificData) ex->ITexUploadAll(texture_);
+        }
+        if (texture_->m_apiSpecificData) ex->ITexTouch(texture_);
+    }
+    if (!texture_->m_apiSpecificData) return "Waiting for the film texture.";
+    C44Matrix view;
+    GxXformView(view);
+    C44Matrix combined = view * g_theGxDevicePtr->m_projNative;
+    D3DMATRIX projection;
+    static_assert(sizeof(combined) == sizeof(projection));
+    memcpy(&projection,&combined,sizeof(projection));
+    float rx = right.x*4, ry = right.y*4, rz = 4/aspect;
+    Vertex corners[] = {{p.x-rx,p.y-ry,p.z+rz,0,0},{p.x+rx,p.y+ry,p.z+rz,1,0},
+                        {p.x-rx,p.y-ry,p.z-rz,0,1},{p.x+rx,p.y+ry,p.z-rz,1,1}};
+    return pipeline_.draw(d,static_cast<IDirect3DTexture9*>(texture_->m_apiSpecificData),projection,corners)
+        ? "" : "World-screen draw unavailable.";
+}
+}
