+    bool start(Player next, const std::filesystem::path& clientDirectory);
+    bool live();
+    void close();
+    bool frame();
+    bool control(const std::string& command, const std::string& text, int value);
+    bool snapshot(CoAFilmPlex::UiSnapshot& snap);
+};
+}
