+    std::vector<unsigned char> pixels;
+    unsigned width() const { return player == Player::Plex ? CoAFilmPlex::kWidth : CoAFilmCinema::kWidth; }
+    unsigned height() const { return player == Player::Plex ? CoAFilmPlex::kHeight : CoAFilmCinema::kHeight; }
