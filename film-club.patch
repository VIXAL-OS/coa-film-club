+#pragma once
+#include "CinemaProtocol.h"
+#include "PlexProtocol.h"
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace CoAFilm {
+enum class Player { Cinema, Plex };
+class View {
+    void* view_ = nullptr;
+public:
+    ~View() { reset(); }
+    void reset();
+    void* open(DWORD pid, const wchar_t* name, DWORD access, size_t bytes);
