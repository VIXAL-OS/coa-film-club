diff --git a/FilmClub/prepare-workers.py b/FilmClub/prepare-workers.py
new file mode 100644
index 0000000000000000000000000000000000000000..36eaff3e5997c70a47351724ea9a05e55abeae74
--- /dev/null
+++ b/FilmClub/prepare-workers.py
@@ -0,0 +1,63 @@
+"""Prepare source-isolated x64 helpers from the matching AzerothPlex and Stonewall TV trees."""
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parent
+if len(sys.argv)!=4:
+    raise SystemExit("Usage: python FilmClub/prepare-workers.py PLEX_CHECKOUT CINEMA_CHECKOUT EMPTY_BUILD_DIR")
+plex, cinema, build = [Path(s).resolve() for s in sys.argv[1:]]
+if build.exists() and any(build.iterdir()):
+    raise SystemExit("Use an empty build directory.")
+build.mkdir(parents=True,exist_ok=True)
+ui = build / "protocol"
+ui.mkdir(parents=True, exist_ok=True)
+
+def replace(path, original, new):
+    source = path.read_text(encoding="utf-8-sig")
+    if source.count(original) != 1:
+        raise ValueError(f"Unexpected source in {path}: {original!r}")
+    path.write_text(source.replace(original, new), encoding="utf-8")
+
+for mode, upstream in [("Plex", plex), ("Cinema", cinema)]:
+    source = build / "workers" / mode
+    shutil.copytree(upstream / "host", source, dirs_exist_ok=True)
+    for notice in ("LICENSE", "THIRD_PARTY_NOTICES.md", "MODIFICATIONS.md"):
+        shutil.copy2(upstream / notice, source / notice)
+    header = source / "VideoShared.hpp"
+    shared = header.read_text(encoding="utf-8-sig")
+    # Keep the original data layouts. Each reader opens only its own child's names.
+    (ui / (mode + "Protocol.h")).write_text(
+        shared.replace("namespace wxl_video_shared", "namespace CoAFilm" + mode), encoding="utf-8")
+    for file in [source / "VideoHost.cpp"] + ([source / "FramePublisher.cpp"] if mode == "Plex" else []):
+        content = file.read_text(encoding="utf-8-sig")
+        for symbol, suffix in [("kMappingName", "Frames"), ("kControlMappingName", "Control"), ("kUiMappingName", "Ui")]:
+            content = content.replace("wxl_video_shared::" + symbol + ");",
+                'filmName(L"' + suffix + '", GetCurrentProcessId()).c_str());')
+        file.write_text('#include "FilmWorker.h"\n' + content, encoding="utf-8")
+    host = source / "VideoHost.cpp"
+    replace(host, "const DWORD parentPid = ParseParentPid(commandLine);",
+            "if (!filmOpenLifetime(commandLine)) return 8;\n    const DWORD parentPid = ParseParentPid(commandLine);")
+    replace(host, "case WM_TIMER:", "case WM_TIMER:\n            if (filmStopping()) { PostMessageW(window, WM_CLOSE, 0, 0); return 0; }")
+    replace(host, 'L"WarcraftXL" /', 'L"CoAFilmClub" /')
+    replace(host, "g_lastCommandSequence = commandSequence;",
+            "g_lastCommandSequence = commandSequence;\n                InterlockedExchange(&control->command, 0);")
+    if mode == "Plex":
+        replace(host, "g_lastUiCommandSequence = sequence;",
+                "g_lastUiCommandSequence = sequence;\n        InterlockedExchange(&bridge->command.command, 0);")
+    replace(host, "LocalDataDirectory()\n    {",
+            'LocalDataDirectory()\n    {\n        wchar_t profile[32768];\n'
+            '        DWORD n = GetEnvironmentVariableW(L"COAFILM_PROFILE_ROOT", profile, 32768);\n'
+            '        if (n && n < 32768 && std::filesystem::path(profile).is_absolute()) {\n'
+            '            auto path = std::filesystem::path(profile) / L"' + mode + '";\n'
+            '            std::error_code ec; std::filesystem::create_directories(path, ec);\n'
+            '            return ec ? std::wstring{} : path.wstring();\n        }')
+    shutil.copy2(root / "FilmWorker.h", source / "FilmWorker.h")
+    if mode == "Plex":
+        subprocess.run(["git","init","-q"],cwd=source,check=True)
+        subprocess.run(["git", "apply", "--no-index", str(root / "plex-party.patch")], cwd=source, check=True)
+    if mode == "Cinema":
+        replace(source / "CMakeLists.txt", "/x86/WebView2LoaderStatic.lib", "/x64/WebView2LoaderStatic.lib")
+        shutil.copy2(upstream / "player.html", source / "player.html")
+
diff --git a/WoW/Source/Ui/Film/FilmClub.cpp b/WoW/Source/Ui/Film/FilmClub.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4431aab2d8f02ad68cde6922420b33395b496e51
--- /dev/null
+++ b/WoW/Source/Ui/Film/FilmClub.cpp
@@ -0,0 +1,131 @@
+#include "FilmClub.h"
+#include "FilmTransport.h"
+#include "FilmSurface.h"
+#include "Engine/Source/FrameScript/FrameScript.h"
+#include "Engine/Source/lua-5.1/src/lua.h"
+#include "WoW/Source/Ui/GameUI.h"
+#include "WoW/Source/Ui/WorldFrame.h"
+#include "WoW/Source/ObjectMgrClient/ObjectMgrClient.h"
+#include <cmath>
+#include <memory>
+
+namespace {
+using namespace CoAFilm;
+Session session;
+Surface surface;
+float aspect = 16.f/9.f;
+ULONGLONG nextAspect = 0;
+bool placed = false;
+uint32_t mapId = 0;
+C3Vector center, right;
+std::string screenMessage;
+
+int action(lua_State* L) {
+    size_t n = 0;
+    const char* arg = lua_tolstring(L, 1, &n);
+    if (!arg || n > 32) return 0;
+    std::string cmd(arg, n);
+    const char* body = lua_tolstring(L, 2, &n);
+    if (body && n > 1023) { lua_pushboolean(L, 0); lua_pushstring(L,"Input is too long."); return 2; }
+    std::string text = body ? std::string(body, n) : "";
+    double number = lua_tonumber(L, 3);
+    int value = std::isfinite(number) && number >= 0 && number <= 100 ? int(number) : -1;
+    bool ok = false;
+    std::string message;
+    if (cmd == "cinema" || cmd == "plex") {
+        wchar_t path[32768];
+        DWORD count = GetModuleFileNameW(nullptr, path, static_cast<DWORD>(std::size(path)));
+        Player next = cmd == "plex" ? Player::Plex : Player::Cinema;
+        if (count && count < std::size(path)) {
+            bool changing = !session.live() || next != session.player;
+            ok = session.start(next, std::filesystem::path(path).parent_path());
+            if (ok && changing) { aspect=16.f/9.f; nextAspect=0; surface.reset(); screenMessage.clear(); }
+        }
+        message = session.status;
+    } else if (cmd == "close") {
+        FilmShutdown(); ok = true;
+    } else if (cmd == "hide") {
+        placed = false; surface.reset(); screenMessage.clear(); ok = true;
+    } else if (cmd == "place") {
+        if (CGGameUI::s_inWorld && CGWorldFrame::GetActiveCamera() && Surface::device()) {
+            C3Vector eye, dir;
+            CGWorldFrame::GetCameraPosition(&eye); CGWorldFrame::GetCameraFacing(&dir);
+            float horiz = std::hypot(dir.x, dir.y);
+            if (horiz > 0.02f) {
+                center = C3Vector(eye.x+dir.x*12, eye.y+dir.y*12, eye.z+dir.z*12);
+                right = C3Vector(dir.y/horiz, -dir.x/horiz, 0);
+                mapId = ClntObjMgrGetMapID(); placed = true; ok = true; screenMessage.clear();
+            }
+        }
+        if (!ok) message = "Place the screen in a D3D9 world view while looking toward the horizon.";
+    } else {
+        ok = session.control(cmd, text, value);
+        if (!ok) message = session.opened() ? "Player is starting, or this input is unavailable." : session.status;
+    }
+    lua_pushboolean(L, ok); lua_pushlstring(L, message.data(), message.size());
+    return 2;
+}
+void field(lua_State* L, const char* name, const char* value, size_t size) {
+    lua_pushlstring(L, value, strnlen_s(value, size));
+    lua_setfield(L, -2, name);
+}
+int state(lua_State* L) {
+    namespace P = CoAFilmPlex;
+    bool alive = session.live();
+    lua_newtable(L);
+    lua_pushstring(L, alive ? (session.player == Player::Plex ? "plex" : "cinema") : "closed");
+    lua_setfield(L,-2,"player");
+    lua_pushboolean(L, placed); lua_setfield(L,-2,"placed");
+    lua_pushstring(L, session.status.c_str()); lua_setfield(L,-2,"status");
+    lua_pushstring(L, screenMessage.c_str()); lua_setfield(L,-2,"screen");
+    if (!alive || session.player != Player::Plex) return 1;
+    static P::UiSnapshot snap;
+    if (!session.snapshot(snap)) return 1;
+    if (snap.status[0]) field(L,"status",snap.status,sizeof(snap.status));
+    field(L,"error",snap.error,sizeof(snap.error)); field(L,"room",snap.partyRoomCode,sizeof(snap.partyRoomCode));
+    field(L,"partyError",snap.partyError,sizeof(snap.partyError));
+    if (snap.cytube.active) field(L,"status",snap.cytube.status,sizeof(snap.cytube.status));
+    auto list = [&](const char* key, const auto& entries, unsigned count, auto getName) {
+        unsigned size = std::min<unsigned>(count, static_cast<unsigned>(std::size(entries)));
+        lua_createtable(L, size, 0);
+        for (unsigned i=0; i<size; ++i) {
+            const auto& name = getName(entries[i]);
+            lua_pushlstring(L,name,strnlen_s(name,sizeof(name)));
+            lua_rawseti(L,-2,i+1);
+        }
+        lua_setfield(L,-2,key);
+    };
+    list("server",snap.servers,snap.serverCount,[](const auto& e)->const auto& { return e.name; });
+    list("library",snap.sections,snap.sectionCount,[](const auto& e)->const auto& { return e.title; });
+    list("item",snap.items,snap.itemCount,[](const auto& e)->const auto& { return e.title; });
+    return 1;
+}
+}
+
+void FilmRegister() {
+    FrameScript_RegisterFunction("CoAFilmAction", action);
+    FrameScript_RegisterFunction("CoAFilmState", state);
+}
+void FilmInstallPanel() {
+    static const char panel[] =
+#include "FilmPanel.lua.inc"
+    ;
+    FrameScript_ExecuteBuffer(panel, sizeof(panel)-1, "CoAFilmClub", nullptr, nullptr);
+}
+void FilmShutdown() {
+    placed = false; surface.reset(); session.close(); screenMessage.clear();
+}
+void FilmDraw(const C3Vector& eye) {
+    if (!placed || !session.opened() || mapId != ClntObjMgrGetMapID()) return;
+    C3Vector relative(center.x-eye.x, center.y-eye.y, center.z-eye.z);
+    if (relative.x*relative.x+relative.y*relative.y+relative.z*relative.z > 160.f*160.f) return;
+    bool changed = session.frame();
+    if (session.pixels.empty()) { if (!session.opened()) surface.reset(); return; }
+    if (session.player == Player::Plex && GetTickCount64() >= nextAspect) {
+        static CoAFilmPlex::UiSnapshot snap;
+        nextAspect = GetTickCount64()+500;
+        if (session.snapshot(snap) && snap.videoAspectRatio >= 0.25f && snap.videoAspectRatio <= 5.f)
+            aspect = snap.videoAspectRatio;
+    }
+    screenMessage = surface.draw(session.pixels, session.width(), session.height(), changed, relative, right, aspect);
+}
